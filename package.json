    "build": "npm run build:mac && npm run build:win"
  },
  "dependencies": {
    "koffi": "3.3.2"
  },
  "devDependencies": {
    "electron": "44.7.0",
    "@electron/packager": "20.3.0"
  },
  "type": "module"
}
