{
  "name": "cmd-send",
  "version": "0.1.22",
  "description": "TXT command editor and targeted desktop input for macOS and Windows",
  "main": "electron/main.cjs",
  "private": true,
  "author": "tangyuanx",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "test": "node --test --test-concurrency=1 tests/*.test.mjs",
    "build:mac": "node scripts/package.mjs darwin arm64",
    "build:win": "node scripts/package.mjs win32 x64",
    "build": "npm run build:mac && npm run build:win",
    "test:update": "node scripts/test-windows-update.mjs",
    "test:mobax": "node scripts/test-mobaxterm.mjs",
    "test:search": "node scripts/test-search.mjs",
    "test:repeat": "node scripts/test-repeat.mjs",
    "test:scenes": "node scripts/test-scenes.mjs",
    "test:target": "node scripts/test-target-drag.mjs",
    "test:schedules": "node scripts/test-schedules.mjs",
    "test:update-notes": "node scripts/test-update-notes.mjs",
    "test:schedule-import": "node scripts/test-schedule-import.mjs",
    "preview:ui": "node scripts/export-ui-preview.mjs",
    "test:ui": "npm run preview:ui && node scripts/test-ui.mjs"
  },
  "dependencies": {
    "electron-updater": "6.8.9",
    "koffi": "3.3.2"
  },
  "devDependencies": {
    "@electron/packager": "20.3.0",
    "electron": "44.7.0",
    "electron-builder": "26.15.3",
    "playwright": "1.64.0",
    "ssh2": "1.17.0"
  },
  "type": "module"
}
