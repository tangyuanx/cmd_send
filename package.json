{
  "name": "cmd-send",
  "version": "0.1.0",
  "description": "TXT command editor and targeted desktop input for macOS and Windows",
  "main": "electron/main.cjs",
  "private": true,
  "author": "tangyuanx",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.mjs",
    "build:mac": "node scripts/package.mjs darwin arm64",
